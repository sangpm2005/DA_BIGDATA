FROM bigdata-review-runtime:local AS runtime
FROM apache/airflow:2.10.5-python3.11
USER root
COPY --from=runtime /opt/java/openjdk /opt/java/openjdk
COPY --from=runtime /opt/hadoop /opt/hadoop
COPY --from=runtime /opt/spark /opt/spark
ENV JAVA_HOME=/opt/java/openjdk \
    HADOOP_HOME=/opt/hadoop \
    HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop \
    SPARK_HOME=/opt/spark \
    PYSPARK_PYTHON=/usr/local/bin/python \
    PYSPARK_DRIVER_PYTHON=/usr/local/bin/python \
    PYTHONPATH=/workspace/src:/opt/spark/python:/opt/spark/python/lib/py4j-0.10.9.7-src.zip \
    PATH=/opt/hadoop/bin:/opt/spark/bin:/opt/java/openjdk/bin:$PATH
USER airflow
RUN pip install --no-cache-dir "apache-airflow==2.10.5" "numpy==1.26.4" "kafka-python==2.2.15"

